# Copy this file to .env for local development only.
# Never commit real passwords, tokens, keys, or connection strings.

FABRIC_WORKSPACE_NAME="Industrial Data Platform - Lakehouse Analytics"
FABRIC_BRONZE_LAKEHOUSE=lh_bronze
FABRIC_SILVER_LAKEHOUSE=lh_silver
FABRIC_GOLD_LAKEHOUSE=lh_gold

# Local AtlasERP source. Use the Docker Compose default only for synthetic development data.
ATLAS_ERP_HOST=localhost
ATLAS_ERP_PORT=5432
ATLAS_ERP_DATABASE=atlas_industrial
ATLAS_ERP_ADMIN_USER=atlas_admin
ATLAS_ERP_ADMIN_PASSWORD=replace-with-local-development-secret
ATLAS_ERP_DSN=postgresql://atlas_admin:replace-with-local-development-secret@127.0.0.1:5432/atlas_industrial
# Future gateway/Fabric reader. It has only USAGE/SELECT on atlas_erp.
ATLAS_ERP_READER_USER=atlas_fabric_reader
ATLAS_ERP_READER_PASSWORD=atlas_reader_local_only

# Local MaintControl API. Do not commit the token used for a public tunnel.
MAINTCONTROL_BASE_URL=http://localhost:8000
MAINTCONTROL_API_TOKEN=replace-with-local-development-token
